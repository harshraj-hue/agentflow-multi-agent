# ---------- App ----------
ENVIRONMENT=development        # development | testing | production
LOG_LEVEL=INFO
LOG_JSON=true                  # true = JSON logs, false = human-readable
CORS_ORIGINS=http://localhost:5173   # comma-separated list

# ---------- Database ----------
# Used by docker-compose.yml to create the database container.
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=agentflow
# Host port. 5433 (not 5432) so it does not clash with another local PostgreSQL.
POSTGRES_PORT=5433

# Used by the backend when it runs on your machine (not in Docker).
# Keep user/password/port identical to the values above.
DATABASE_URL=postgresql+psycopg://agentflow:change_me_dev_only@localhost:5433/agentflow

